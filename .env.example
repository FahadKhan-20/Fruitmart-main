# MD FRESH Store - Environment Variables Template
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-fruitmart-database-key

# Razorpay Gateway Keys (Get from https://dashboard.razorpay.com)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Stripe Keys (Optional Fallback)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Razorpay webhook secret (Dashboard > Settings > Webhooks, event qr_code.credited)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Shop-manager API token. Required for GET /api/orders and PATCH /api/orders/:id
# (send as "Authorization: Bearer <token>"). Leave empty to keep those endpoints closed.
ADMIN_API_TOKEN=

# Direct UPI (no payment gateway). Every order gets its own QR for this UPI ID with the
# exact amount and order ID. The shop confirms payments in /admin ("Mark as paid").
# Leave SHOP_UPI_ID empty to use Razorpay QR instead (automatic confirmation).
SHOP_UPI_ID=yourshop@ybl
SHOP_UPI_NAME=MD Fresh Store
# Add 1-99 paise per open order so each payment amount is unique (true/false)
UPI_UNIQUE_PAISE=true

# Delivery partner access code for /rider (at least 6 characters). Riders can only move
# orders through delivery and record cash/UPI collected at the door. Empty = rider app closed.
RIDER_ACCESS_CODE=
